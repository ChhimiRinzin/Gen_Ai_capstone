# RoadSentry AI - Environment Variables Template
# Copy this file to .env or configure these variables in your Vercel Project Settings

# GROQ API Configuration (Server-Side Only - Never exposed to client)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Groq Supported Models
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

# GEMINI_API_KEY: Optional fallback
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / Vercel deployment URL
APP_URL="MY_APP_URL"

# Server Port
PORT=3000
NODE_ENV="production"
