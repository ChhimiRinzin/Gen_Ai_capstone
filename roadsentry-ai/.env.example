# RoadSentry AI - Environment Configuration
# Copy this file to .env and configure your secrets

# Groq API Configuration for Generative and Multimodal AI
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Models (Supported Vision and Text Models)
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Application Settings
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Optional custom model path (default: models/road_damage_yolov8n.pt or yolov8n.pt)
YOLO_MODEL_PATH=models/road_damage_yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Maximum upload limits (MB)
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=50
MAX_DOC_SIZE_MB=25
